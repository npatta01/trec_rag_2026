# Copy this file to .env and fill in the token locally.

# Public hosted ClimbMix Pyserini search endpoint.
INDEX_URL=http://api.castorini.uwaterloo.ca/v1/climbmix-400b/search

# Private access token. Do not commit a filled-in value.
PYSERINI_API_TOKEN=

# Notebook/query defaults.
EXTERNAL_PYSERINI_HITS=5
# One request start per host every three seconds, no burst. Keep this database
# on shared durable storage when multiple processes use the same API budget.
PYSERINI_MIN_INTERVAL_SECONDS=3
PYSERINI_RATE_BURST=1
PYSERINI_LIMITER_STATE_PATH=cache/retrieval/pyserini_remote/rate-limit.sqlite
# SAMPLE_QUERIES=first query; second query
