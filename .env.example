# Copy this file to .env and fill in the token locally.

# Public hosted Pyserini endpoint defaults.
DEFAULT_BASE_URL=http://api.castorini.uwaterloo.ca
DEFAULT_INDEX=climbmix-400b

# Use INDEX_URL instead if you want to provide the full search endpoint directly.
# INDEX_URL=http://api.castorini.uwaterloo.ca/v1/climbmix-400b/search

# Private access token. Do not commit a filled-in value.
PYSERINI_API_TOKEN=

# Notebook/query defaults.
EXTERNAL_PYSERINI_HITS=5
# SAMPLE_QUERIES=first query; second query
