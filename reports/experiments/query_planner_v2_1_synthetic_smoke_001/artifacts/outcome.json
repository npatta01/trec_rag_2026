ntence, desire statement, and coordinated clause before\n   finalizing. Verify atomic coverage, exact partition, and anchor scope.\n\n# Exact response schema\n\n{\"additionalProperties\":false,\"properties\":{\"anchors\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"anchor_id\":{\"pattern\":\"^[A-Za-z][A-Za-z0-9_-]{0,31}$\",\"type\":\"string\"},\"coverage_refs\":{\"items\":{\"pattern\":\"^[A-Za-z][A-Za-z0-9_-]{0,31}$\",\"type\":\"string\"},\"maxItems\":16,\"type\":\"array\"},\"kind\":{\"enum\":[\"entity\",\"topic\",\"relation\",\"comparison\",\"geography\",\"time\",\"population\",\"metric\",\"constraint\",\"modality\"],\"type\":\"string\"},\"range\":{\"additionalProperties\":false,\"properties\":{\"end_token\":{\"maximum\":22,\"minimum\":1,\"type\":\"integer\"},\"start_token\":{\"maximum\":21,\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"start_token\",\"end_token\"],\"type\":\"object\"},\"scope\":{\"enum\":[\"global\",\"coverage\"],\"type\":\"string\"}},\"required\":[\"anchor_id\",\"range\",\"kind\",\"scope\",\"coverage_refs\"],\"type\":\"object\"},\"maxItems\":64,\"minItems\":1,\"type\":\"array\"},\"coverage_items\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"coverage_id\":{\"pattern\":\"^[A-Za-z][A-Za-z0-9_-]{0,31}$\",\"type\":\"string\"},\"source_span_refs\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"end_token\":{\"maximum\":22,\"minimum\":1,\"type\":\"integer\"},\"start_token\":{\"maximum\":21,\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"start_token\",\"end_token\"],\"type\":\"object\"},\"maxItems\":2,\"minItems\":1,\"type\":\"array\"}},\"required\":[\"coverage_id\",\"source_span_refs\"],\"type\":\"object\"},\"maxItems\":16,\"minItems\":1,\"type\":\"array\"},\"facets\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"coverage_refs\":{\"items\":{\"pattern\":\"^[A-Za-z][A-Za-z0-9_-]{0,31}$\",\"type\":\"string\"},\"maxItems\":2,\"minItems\":1,\"type\":\"array\"},\"expansion_terms\":{\"item